# Location: backend/.env.example
# Purpose: A safe template of the settings the Inkwell backend needs. Copy this
# file, rename the copy to ".env", and fill in your own values. It contains no
# real secrets, so it is safe to upload to GitHub.

PORT=4000
FRONTEND_URL="http://localhost:3000"

# Your Postgres connection string (for example from Neon, with pooling OFF).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# A long random text (at least 32 characters) used to sign login tokens.
JWT_SECRET="replace-with-a-long-random-text"

# The email that becomes the Super Admin when it registers first.
SUPER_ADMIN_EMAIL="you@example.com"

# OPTIONAL. Your Paystack secret key. Use a TEST key (it starts with sk_test_)
# while building. Leave it empty until you have a Paystack account.
PAYSTACK_SECRET_KEY=""

# OPTIONAL. Set to "true" to test payments on your own computer without any
# payment account. It is ignored when NODE_ENV is "production".
PAYMENTS_SANDBOX=""

# Location: backend/.env.example
# End of file: .env.example