// Project: Inkwell
// Location: backend/prisma/schema.prisma
// Purpose: The complete database plan for Inkwell. Every table (model) and the
// links between them are defined here. Money is stored as whole cents (Int) to
// avoid rounding errors. This version adds series, co-authors, unique story
// views, reading days (streaks), badges, writing challenges, email tokens
// (password reset and verification), a token version (log out everywhere) and
// reader settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- ENUMS

enum AdminRank {
  SUPER_ADMIN
  SENIOR_ADMIN
  AD_MANAGER
  MODERATOR
  EDITOR
  SUPPORT
}

enum WriterStatus {
  NONE
  PENDING
  APPROVED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum StoryKind {
  STORY
  ARTICLE
}

enum StoryStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum ChapterStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum CommentStatus {
  VISIBLE
  HIDDEN
}

enum ReportTargetType {
  STORY
  CHAPTER
  COMMENT
  USER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum AdPlacement {
  TOP_BANNER
  SIDEBAR
  BETWEEN_CHAPTERS
  UNDER_POST
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum MembershipStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum NotificationType {
  NEW_CHAPTER
  NEW_FOLLOWER
  COMMENT_REPLY
  LIKE
  TIP
  GIFT
  SYSTEM
}

enum LedgerEntryType {
  TIP
  GIFT
  MEMBERSHIP
  PAYOUT
  PAYOUT_REVERSAL
}

enum PayoutStatus {
  PENDING
  PAID
  REJECTED
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum CollaboratorStatus {
  PENDING
  ACCEPTED
}

// ---------------------------------------------------------------- USERS

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  username        String       @unique
  passwordHash    String
  displayName     String
  bio             String?
  avatarUrl       String?
  country         String?
  writerStatus    WriterStatus @default(NONE)
  adminRank       AdminRank?
  status          UserStatus   @default(ACTIVE)
  statusReason    String?
  bannedUntil     DateTime?
  premiumUntil    DateTime?
  tokenVersion    Int          @default(0)
  emailVerifiedAt DateTime?
  readerPrefs     Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  socialLinks         SocialLink[]
  permissionOverrides AdminPermissionOverride[]
  logsAsActor         AdminActionLog[]          @relation("LogActor")
  logsAsTarget        AdminActionLog[]          @relation("LogTarget")
  stories             Story[]
  series              Series[]
  collaborations      StoryCollaborator[]       @relation("CollaboratorUser")
  invitationsSent     StoryCollaborator[]       @relation("CollaboratorInviter")
  comments            Comment[]
  likes               Like[]
  following           Follow[]                  @relation("Follower")
  followers           Follow[]                  @relation("Following")
  libraryEntries      LibraryEntry[]
  readingProgress     ReadingProgress[]
  readingDays         ReadingDay[]
  badges              UserBadge[]
  emailTokens         EmailToken[]
  notifications       Notification[]
  reportsMade         Report[]                  @relation("ReportReporter")
  reportsHandled      Report[]                  @relation("ReportHandler")
  adsCreated          Ad[]
  challengesCreated   Challenge[]               @relation("ChallengeCreator")
  membershipTiers     MembershipTier[]
  memberships         Membership[]
  tipsSent            Tip[]                     @relation("TipSender")
  tipsReceived        Tip[]                     @relation("TipReceiver")
  giftsSent           GiftTransaction[]         @relation("GiftSender")
  giftsReceived       GiftTransaction[]         @relation("GiftReceiver")
  payments            Payment[]
  ledgerEntries       LedgerEntry[]
  payoutRequests      PayoutRequest[]           @relation("PayoutOwner")
  payoutsHandled      PayoutRequest[]           @relation("PayoutHandler")
  conversationsAsA    Conversation[]            @relation("ConversationUserA")
  conversationsAsB    Conversation[]            @relation("ConversationUserB")
  messagesSent        Message[]
  blocksMade          UserBlock[]               @relation("Blocker")
  blocksReceived      UserBlock[]               @relation("Blocked")

  @@index([adminRank])
}

model SocialLink {
  id       String @id @default(cuid())
  userId   String
  platform String
  url      String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

// A one-time token sent by email, for resetting a password or verifying an
// email address. Only a hash of the token is stored, never the token itself.
model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ---------------------------------------------------------------- ADMIN POWER

// One row = "this specific admin is allowed / blocked from this one ability".
model AdminPermissionOverride {
  id         String   @id @default(cuid())
  userId     String
  permission String
  allowed    Boolean
  setById    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

// Every admin action is recorded here so you can see who did what.
model AdminActionLog {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String?
  action       String
  details      Json?
  createdAt    DateTime @default(now())
  actor        User     @relation("LogActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser   User?    @relation("LogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
}

// ---------------------------------------------------------------- STORIES

model Story {
  id          String      @id @default(cuid())
  authorId    String
  kind        StoryKind   @default(STORY)
  title       String
  slug        String      @unique
  synopsis    String?
  coverUrl    String?
  language    String      @default("en")
  isMature    Boolean     @default(false)
  status      StoryStatus @default(DRAFT)
  isFeatured  Boolean     @default(false)
  viewCount   Int         @default(0)
  seriesId    String?
  seriesOrder Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  publishedAt DateTime?

  author           User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  series           Series?             @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  chapters         Chapter[]
  tags             Tag[]
  comments         Comment[]
  likes            Like[]
  libraryEntries   LibraryEntry[]
  readingProgress  ReadingProgress[]
  gifts            GiftTransaction[]
  collaborators    StoryCollaborator[]
  views            StoryView[]
  challengeEntries ChallengeEntry[]

  @@index([authorId])
  @@index([status, publishedAt])
  @@index([seriesId, seriesOrder])
}

// A group of stories that belong together (for example Book 1, Book 2).
model Series {
  id          String   @id @default(cuid())
  authorId    String
  title       String
  slug        String   @unique
  description String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  stories Story[]

  @@index([authorId])
}

// A second writer invited to work on someone else's story.
model StoryCollaborator {
  id          String             @id @default(cuid())
  storyId     String
  userId      String
  invitedById String
  status      CollaboratorStatus @default(PENDING)
  createdAt   DateTime           @default(now())

  story     Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User  @relation("CollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("CollaboratorInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([userId, status])
}

// One row per story, per reader (or visitor), per day: counts each reader once
// a day. viewerKey is a user id or a scrambled (hashed) visitor address.
model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  viewerKey String
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerKey, day])
  @@index([storyId, day])
}

model Tag {
  id      String  @id @default(cuid())
  name    String  @unique
  slug    String  @unique
  stories Story[]
}

model Chapter {
  id            String        @id @default(cuid())
  storyId       String
  number        Int
  title         String
  content       String        @db.Text
  videoUrl      String?
  status        ChapterStatus @default(DRAFT)
  scheduledAt   DateTime?
  publishedAt   DateTime?
  isMembersOnly Boolean       @default(false)
  wordCount     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  story           Story             @relation(fields: [storyId], references: [id], onDelete: Cascade)
  comments        Comment[]
  readingProgress ReadingProgress[]

  @@unique([storyId, number])
}

// ---------------------------------------------------------------- SOCIAL

model Comment {
  id             String        @id @default(cuid())
  authorId       String
  storyId        String
  chapterId      String?
  parentId       String?
  paragraphIndex Int?
  body           String        @db.Text
  status         CommentStatus @default(VISIBLE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  story   Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter Chapter?  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
  likes   Like[]

  @@index([storyId])
  @@index([chapterId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  storyId   String?
  commentId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  story   Story?   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@unique([userId, commentId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model LibraryEntry {
  id        String   @id @default(cuid())
  userId    String
  storyId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
}

model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  storyId   String
  chapterId String
  position  Float    @default(0)
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  story   Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
}

// One row per reader per day they read something. Reading streaks are worked
// out from these rows.
model ReadingDay {
  id     String   @id @default(cuid())
  userId String
  day    DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// A badge a person has earned. The badge list itself lives in the code.
model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  code      String
  awardedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// ---------------------------------------------------------------- CHALLENGES

// A writing challenge run by Inkwell, for example "Write a story in 7 days".
model Challenge {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  prompt      String   @db.Text
  startsAt    DateTime
  endsAt      DateTime
  createdById String
  createdAt   DateTime @default(now())

  createdBy User             @relation("ChallengeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  entries   ChallengeEntry[]

  @@index([startsAt, endsAt])
}

model ChallengeEntry {
  id          String   @id @default(cuid())
  challengeId String
  storyId     String
  isWinner    Boolean  @default(false)
  submittedAt DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  story     Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([challengeId, storyId])
}

// ---------------------------------------------------------------- MESSAGING

// One private conversation between two people. The two ids are always stored
// in sorted order (userAId is the smaller id), so a pair of people can only
// ever have ONE conversation. Each side has its own "last read" time, which is
// how unread messages are counted.
model Conversation {
  id              String   @id @default(cuid())
  userAId         String
  userBId         String
  userALastReadAt DateTime @default(now())
  userBLastReadAt DateTime @default(now())
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

// "blocker has blocked blocked". Blocking stops messages in both directions.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

// ---------------------------------------------------------------- MODERATION

model Report {
  id          String           @id @default(cuid())
  reporterId  String
  targetType  ReportTargetType
  targetId    String
  reason      String
  status      ReportStatus     @default(OPEN)
  handledById String?
  handledNote String?
  createdAt   DateTime         @default(now())
  resolvedAt  DateTime?

  reporter  User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  handledBy User? @relation("ReportHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// ---------------------------------------------------------------- ADS

model Ad {
  id              String      @id @default(cuid())
  title           String
  imageUrl        String?
  bodyText        String?
  linkUrl         String
  placement       AdPlacement
  startsAt        DateTime
  endsAt          DateTime
  isActive        Boolean     @default(true)
  targetCountries String[]
  targetTags      String[]
  views           Int         @default(0)
  clicks          Int         @default(0)
  createdById     String
  createdAt       DateTime    @default(now())

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([placement, isActive])
}

// Simple key/value settings, for example "adsense_enabled" = "true".
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- MONEY

model MembershipTier {
  id          String  @id @default(cuid())
  writerId    String
  name        String
  description String?
  priceCents  Int
  currency    String  @default("USD")
  isActive    Boolean @default(true)

  writer      User         @relation(fields: [writerId], references: [id], onDelete: Cascade)
  memberships Membership[]
}

model Membership {
  id           String           @id @default(cuid())
  subscriberId String
  tierId       String
  status       MembershipStatus @default(ACTIVE)
  startedAt    DateTime         @default(now())
  endsAt       DateTime?

  subscriber User           @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  tier       MembershipTier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, tierId])
}

// One attempt to pay. amountCents is what the payer is charged, in "currency"
// (USD or KES). usdCents is the same value in US dollars. purpose is TIP, GIFT,
// MEMBERSHIP or PREMIUM, and metadata holds the details needed to deliver it
// once the payment succeeds.
model Payment {
  id          String        @id @default(cuid())
  userId      String
  provider    String
  providerRef String?       @unique
  amountCents Int
  currency    String        @default("USD")
  usdCents    Int           @default(0)
  purpose     String
  metadata    Json?
  status      PaymentStatus @default(PENDING)
  failureNote String?
  createdAt   DateTime      @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// The writer wallet. Positive amounts are earnings, negative amounts are
// payouts. A writer's balance is the sum of their entries (in US dollar cents).
// paymentId is unique, so one payment can only ever credit a writer once.
model LedgerEntry {
  id          String          @id @default(cuid())
  userId      String
  type        LedgerEntryType
  amountCents Int
  paymentId   String?         @unique
  payoutId    String?
  note        String?
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([payoutId])
}

model PayoutRequest {
  id          String       @id @default(cuid())
  userId      String
  amountCents Int
  method      String
  details     String
  status      PayoutStatus @default(PENDING)
  handledById String?
  handledNote String?
  createdAt   DateTime     @default(now())
  handledAt   DateTime?

  user      User  @relation("PayoutOwner", fields: [userId], references: [id], onDelete: Cascade)
  handledBy User? @relation("PayoutHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model Tip {
  id               String   @id @default(cuid())
  senderId         String
  receiverId       String
  amountCents      Int
  platformFeeCents Int
  currency         String   @default("USD")
  message          String?
  createdAt        DateTime @default(now())

  sender   User @relation("TipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("TipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}

model GiftType {
  id         String  @id @default(cuid())
  name       String  @unique
  emoji      String
  priceCents Int
  isActive   Boolean @default(true)

  transactions GiftTransaction[]
}

model GiftTransaction {
  id               String   @id @default(cuid())
  senderId         String
  receiverId       String
  giftTypeId       String
  storyId          String?
  quantity         Int      @default(1)
  totalCents       Int
  platformFeeCents Int
  createdAt        DateTime @default(now())

  sender   User     @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User     @relation("GiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  giftType GiftType @relation(fields: [giftTypeId], references: [id], onDelete: Restrict)
  story    Story?   @relation(fields: [storyId], references: [id], onDelete: SetNull)
}

